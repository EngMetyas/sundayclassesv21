{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/daily-verse-notify",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/visit-reminders",
      "schedule": "30 5 * * *"
    }
  ]
}
